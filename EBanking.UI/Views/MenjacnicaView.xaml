<Window x:Class="EBanking.UI.Views.MenjacnicaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EBanking.UI.Views"
        mc:Ignorable="d"
        DataContext="{Binding MenjacnicaView, Source={StaticResource Locator}}"
        Title="{Binding Model.Title}" Height="450" Width="800">
    <Grid>
        <Button Command="{Binding KonvertujCommand}" Content="Konvertuj" HorizontalAlignment="Left" Margin="330,338,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="359,122,0,0" TextWrapping="Wrap" Text="{Binding Model.Iznos, Mode=TwoWay}" VerticalAlignment="Top" Width="120"/>
        <TextBox HorizontalAlignment="Left" Margin="358,252,0,0" TextWrapping="Wrap" Text="{Binding Model.KonvertovanaVrednost, Mode=TwoWay}" VerticalAlignment="Top" Width="120"/>
        <Label Content="Konvertovana vrednost" HorizontalAlignment="Left" Margin="226,248,0,0" VerticalAlignment="Top"/>
        <Label Content="Iznos" HorizontalAlignment="Left" Margin="226,122,0,0" VerticalAlignment="Top"/>
        <ComboBox Text="{Binding Model.IzabranRacun.BrojRacuna}" SelectedValue="{Binding Model.IzabranRacun}" ItemsSource="{Binding Path=Model.Racuni}" DisplayMemberPath="BrojRacuna" HorizontalAlignment="Left" Margin="359,183,0,0" VerticalAlignment="Top" Width="120"/>
        <Label Content="{Binding Model.IzabranRacun.Valuta}" HorizontalAlignment="Left" Margin="517,183,0,0" VerticalAlignment="Top"/>
        <Button Content="Gotovo" Command="{Binding PokreniTransakcijuCommand}" HorizontalAlignment="Left" Margin="441,338,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
